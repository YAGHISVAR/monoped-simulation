<?xml version="1.0"?>
<robot name="biped_robot">

  <!-- ==================== MATERIALS ==================== -->
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>

  <!-- ==================== WORLD ==================== -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="pelvis"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== PELVIS ==================== -->
  <link name="pelvis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.14 0.12"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.14 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- ==================== TORSO ==================== -->
  <joint name="torso_joint" type="fixed">
    <parent link="pelvis"/>
    <child link="torso"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.14 0.25"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.14 0.25"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="6.0"/>
      <inertia ixx="0.06" ixy="0" ixz="0"
               iyy="0.05" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- ==================== HEAD ==================== -->
  <joint name="head_joint" type="fixed">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.27" rpy="0 0 0"/>
  </joint>

  <link name="head">
    <visual>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0"
               iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ==================== LEFT LEG ==================== -->

  <!-- Left Hip Roll (abduction/adduction) -->
  <joint name="left_hip_roll" type="revolute">
    <parent link="pelvis"/>
    <child link="left_hip_link"/>
    <origin xyz="0.09 0 -0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="80" velocity="3.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="left_hip_link">
    <visual>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Left Hip Pitch (forward/backward swing) -->
  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_link"/>
    <child link="left_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="80" velocity="3.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="left_thigh">
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.38"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.38"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.2"/>
      <mass value="2.5"/>
      <inertia ixx="0.032" ixy="0" ixz="0"
               iyy="0.032" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Left Knee -->
  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.38" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.0" effort="60" velocity="4.0"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <link name="left_shin">
    <visual>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.37"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.37"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.185"/>
      <mass value="1.5"/>
      <inertia ixx="0.018" ixy="0" ixz="0"
               iyy="0.018" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Left Ankle -->
  <joint name="left_ankle" type="revolute">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.37" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="40" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="left_foot">
    <visual>
      <origin xyz="0.04 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.08 0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 -0.02"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- ==================== RIGHT LEG ==================== -->

  <!-- Right Hip Roll -->
  <joint name="right_hip_roll" type="revolute">
    <parent link="pelvis"/>
    <child link="right_hip_link"/>
    <origin xyz="-0.09 0 -0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="80" velocity="3.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="right_hip_link">
    <visual>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Right Hip Pitch -->
  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_link"/>
    <child link="right_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="80" velocity="3.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="right_thigh">
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.38"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.38"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.2"/>
      <mass value="2.5"/>
      <inertia ixx="0.032" ixy="0" ixz="0"
               iyy="0.032" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Right Knee -->
  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.38" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.0" effort="60" velocity="4.0"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <link name="right_shin">
    <visual>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.37"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.37"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.185"/>
      <mass value="1.5"/>
      <inertia ixx="0.018" ixy="0" ixz="0"
               iyy="0.018" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Right Ankle -->
  <joint name="right_ankle" type="revolute">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.37" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="40" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="right_foot">
    <visual>
      <origin xyz="0.04 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.08 0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.04 0 -0.02"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
  </link>

</robot>
