<mujoco model="biped_robot">

  <!-- ==================== COMPILER ==================== -->
  <compiler angle="radian" inertiafromgeom="true"/>

  <!-- ==================== OPTIONS ==================== -->
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton"/>

  <!-- ==================== DEFAULTS ==================== -->
  <default>
    <joint limited="true" damping="1.0" armature="0.01"/>
    <geom contype="1" conaffinity="1" condim="3"
          friction="1.0 0.005 0.0001" rgba="0.4 0.4 0.4 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <!-- ==================== ASSETS ==================== -->
  <asset>
    <texture name="grid" type="2d" builtin="checker"
             width="512" height="512"
             rgb1="0.85 0.85 0.85" rgb2="0.65 0.65 0.65"/>
    <material name="grid_mat" texture="grid"
              texrepeat="4 4" reflectance="0.3"/>
    <material name="body_mat"  rgba="0.2 0.4 0.8 1"/>
    <material name="joint_mat" rgba="0.9 0.5 0.1 1"/>
    <material name="shin_mat"  rgba="0.3 0.3 0.3 1"/>
    <material name="foot_mat"  rgba="0.8 0.1 0.1 1"/>
    <material name="head_mat"  rgba="0.9 0.9 0.9 1"/>
  </asset>

  <!-- ==================== WORLD ==================== -->
  <worldbody>

    <!-- Ground plane -->
    <geom name="floor" type="plane"
          size="10 10 0.1" pos="0 0 0"
          material="grid_mat" contype="1" conaffinity="1"/>

    <!-- Lighting -->
    <light directional="true" diffuse="0.8 0.8 0.8"
           specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1"/>
    <light directional="true" diffuse="0.4 0.4 0.4"
           pos="2 2 3" dir="-1 -1 -1"/>

    <!-- ===== PELVIS (floating base — free joint) ===== -->
    <body name="pelvis" pos="0 0 1.05">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="box"
            size="0.11 0.07 0.06"
            material="body_mat"/>
      <site name="pelvis_site" pos="0 0 0" size="0.01"/>

      <!-- ===== TORSO ===== -->
      <body name="torso" pos="0 0 0.18">
        <geom name="torso_geom" type="box"
              size="0.12 0.07 0.13" pos="0 0 0.1"
              material="body_mat"/>
        <!-- HEAD -->
        <body name="head" pos="0 0 0.27">
          <geom name="head_geom" type="sphere"
                size="0.08" material="head_mat"/>
        </body>
      </body>

      <!-- ==================== LEFT LEG ==================== -->
      <body name="left_hip" pos="0.09 0 -0.06">
        <!-- Hip roll joint -->
        <joint name="left_hip_roll" type="hinge"
               axis="1 0 0" range="-0.5 0.5"
               damping="2.0" stiffness="5.0"/>
        <geom name="left_hip_geom" type="sphere"
              size="0.045" material="joint_mat"/>

        <body name="left_thigh" pos="0 0 0">
          <!-- Hip pitch joint -->
          <joint name="left_hip_pitch" type="hinge"
                 axis="0 1 0" range="-1.2 1.2"
                 damping="2.0" stiffness="5.0"/>
          <geom name="left_thigh_geom" type="cylinder"
                size="0.04 0.19" pos="0 0 -0.19"
                material="body_mat"/>

          <body name="left_shin" pos="0 0 -0.38">
            <!-- Knee joint -->
            <joint name="left_knee" type="hinge"
                   axis="0 1 0" range="0.0 2.0"
                   damping="1.5" stiffness="3.0"/>
            <geom name="left_shin_geom" type="cylinder"
                  size="0.032 0.185" pos="0 0 -0.185"
                  material="shin_mat"/>

            <body name="left_foot" pos="0 0 -0.37">
              <!-- Ankle joint -->
              <joint name="left_ankle" type="hinge"
                     axis="0 1 0" range="-0.7 0.7"
                     damping="1.0" stiffness="2.0"/>
              <geom name="left_foot_geom" type="box"
                    size="0.09 0.04 0.02" pos="0.04 0 -0.02"
                    material="foot_mat"
                    friction="1.5 0.01 0.001"/>
              <site name="left_foot_site" pos="0 0 -0.04" size="0.01"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== RIGHT LEG ==================== -->
      <body name="right_hip" pos="-0.09 0 -0.06">
        <!-- Hip roll joint -->
        <joint name="right_hip_roll" type="hinge"
               axis="1 0 0" range="-0.5 0.5"
               damping="2.0" stiffness="5.0"/>
        <geom name="right_hip_geom" type="sphere"
              size="0.045" material="joint_mat"/>

        <body name="right_thigh" pos="0 0 0">
          <!-- Hip pitch joint -->
          <joint name="right_hip_pitch" type="hinge"
                 axis="0 1 0" range="-1.2 1.2"
                 damping="2.0" stiffness="5.0"/>
          <geom name="right_thigh_geom" type="cylinder"
                size="0.04 0.19" pos="0 0 -0.19"
                material="body_mat"/>

          <body name="right_shin" pos="0 0 -0.38">
            <!-- Knee joint -->
            <joint name="right_knee" type="hinge"
                   axis="0 1 0" range="0.0 2.0"
                   damping="1.5" stiffness="3.0"/>
            <geom name="right_shin_geom" type="cylinder"
                  size="0.032 0.185" pos="0 0 -0.185"
                  material="shin_mat"/>

            <body name="right_foot" pos="0 0 -0.37">
              <!-- Ankle joint -->
              <joint name="right_ankle" type="hinge"
                     axis="0 1 0" range="-0.7 0.7"
                     damping="1.0" stiffness="2.0"/>
              <geom name="right_foot_geom" type="box"
                    size="0.09 0.04 0.02" pos="0.04 0 -0.02"
                    material="foot_mat"
                    friction="1.5 0.01 0.001"/>
              <site name="right_foot_site" pos="0 0 -0.04" size="0.01"/>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- ==================== ACTUATORS ==================== -->
  <!--
    Motor torque limits (Nm):
      Hip roll  : ±40 Nm
      Hip pitch : ±80 Nm
      Knee      : ±60 Nm
      Ankle     : ±40 Nm
    gear = peak torque (ctrl is normalized -1 to 1)
  -->
  <actuator>
    <motor name="left_hip_roll_motor"  joint="left_hip_roll"  gear="40"  ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="left_hip_pitch_motor" joint="left_hip_pitch" gear="80"  ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="left_knee_motor"      joint="left_knee"      gear="60"  ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="left_ankle_motor"     joint="left_ankle"     gear="40"  ctrllimited="true" ctrlrange="-1 1"/>

    <motor name="right_hip_roll_motor"  joint="right_hip_roll"  gear="40"  ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="right_hip_pitch_motor" joint="right_hip_pitch" gear="80"  ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="right_knee_motor"      joint="right_knee"      gear="60"  ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="right_ankle_motor"     joint="right_ankle"     gear="40"  ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>

  <!-- ==================== SENSORS ==================== -->
  <sensor>
    <accelerometer name="pelvis_accel" site="pelvis_site"/>
    <framepos name="left_foot_pos"  objtype="site" objname="left_foot_site"/>
    <framepos name="right_foot_pos" objtype="site" objname="right_foot_site"/>
    <jointpos name="lhr_pos" joint="left_hip_roll"/>
    <jointpos name="lhp_pos" joint="left_hip_pitch"/>
    <jointpos name="lk_pos"  joint="left_knee"/>
    <jointpos name="la_pos"  joint="left_ankle"/>
    <jointpos name="rhr_pos" joint="right_hip_roll"/>
    <jointpos name="rhp_pos" joint="right_hip_pitch"/>
    <jointpos name="rk_pos"  joint="right_knee"/>
    <jointpos name="ra_pos"  joint="right_ankle"/>
  </sensor>

</mujoco>
