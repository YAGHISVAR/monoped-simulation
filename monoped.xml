<mujoco model="monoped_crank_slider">

  <compiler angle="radian" inertiafromgeom="true"/>

  <option timestep="0.001"
          gravity="0 0 -9.81"
          iterations="100"
          solver="Newton"
          integrator="implicitfast"/>

  <default>
    <joint damping="1.0" armature="0.02"/>
    <geom contype="1" conaffinity="1" condim="3"
          friction="1.2 0.005 0.0001"
          solimp="0.99 0.999 0.001" solref="0.02 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             width="512" height="512"
             rgb1="0.82 0.82 0.82" rgb2="0.60 0.60 0.60"/>
    <material name="grid_mat"   texture="grid" texrepeat="4 4" reflectance="0.2"/>
    <material name="body_mat"   rgba="0.2 0.45 0.85 1"/>
    <material name="joint_mat"  rgba="0.95 0.50 0.10 1"/>
    <material name="lower_mat"  rgba="0.25 0.25 0.25 1"/>
    <material name="rail_mat"   rgba="0.55 0.55 0.55 0.8"/>
    <material name="motor_mat"  rgba="0.1 0.75 0.2 1"/>
    <material name="pelvis_mat" rgba="0.85 0.15 0.10 1"/>
    <material name="foot_mat"   rgba="0.95 0.50 0.10 1"/>
  </asset>

  <worldbody>

    <geom name="floor" type="plane" size="10 10 0.1"
          pos="0 0 0" material="grid_mat"
          contype="1" conaffinity="1"/>

    <light directional="true" diffuse="0.8 0.8 0.8"
           specular="0.2 0.2 0.2" pos="0 0 6" dir="0 0 -1"/>
    <light directional="true" diffuse="0.3 0.3 0.3"
           pos="3 3 4" dir="-1 -1 -1"/>

    <!--
      Vertical guide rail (visual only).
      Spans z = 0.30 → 0.73 to show the pelvis travel range.
    -->
    <geom name="rail" type="cylinder" size="0.014 0.180"
          pos="0 0 0.220" material="rail_mat"
          contype="0" conaffinity="0"/>

    <!--
      FOOT ANCHOR — fixed to world at the ground (z ≈ 0).
      The equality constraint pins the rod tip here.
      Visually: a small flat disc so the grounding point is visible.
    -->
    <body name="foot_anchor" pos="0 0 0">
      <geom name="foot_marker" type="cylinder"
            size="0.040 0.004" pos="0 0 0.004"
            material="foot_mat" contype="0" conaffinity="0"/>
    </body>

    <!--
      PELVIS (red box) — slides ONLY vertically.
      Initial rest height: z = L_crank + L_rod = 0.25 + 0.45 = 0.70 m
      (hip=0, leg straight down, foot on ground).

      The motor and the entire leg mechanism hang from this body.
      As the hip rotates the crank, the pelvis is forced up/down
      because the foot is pinned to the ground via equality.

      slide_z range: pelvis can drop ~0.33 m from rest (hip=90°: z≈0.37 m).
    -->
    <body name="pelvis" pos="0 0 0.40">
      <joint name="slide_z" type="slide"
             axis="0 0 1" range="-0.34 0.02"
             damping="0.8" stiffness="0.0"/>

      <geom name="pelvis_geom" type="box"
            size="0.07 0.055 0.048"
            material="pelvis_mat"/>
      <site name="pelvis_site" pos="0 0 0" size="0.012"/>

      <!-- Motor disc visual on pelvis -->
      <geom name="motor_disc" type="cylinder"
            size="0.042 0.020" euler="1.5708 0 0"
            material="motor_mat" contype="0" conaffinity="0"/>

      <!--
        UPPER LINK (crank): hip hinge on Y-axis, motor-driven.
        At hip=0 the crank hangs straight down (-Z).
        Length = 0.25 m  →  tip at (0,0,-0.25) in upper_link local frame.
      -->
      <body name="upper_link" pos="0 0 0">
        <joint name="hip" type="hinge"
               axis="0 1 0" limited="false"
               damping="1.5" stiffness="0.0"/>

        <geom name="hip_sphere" type="sphere" size="0.030"
              material="joint_mat" contype="0" conaffinity="0"/>
        <geom name="upper_link_geom" type="cylinder"
              size="0.022 0.100" pos="0 0 -0.100"
              material="body_mat" contype="0" conaffinity="0"/>

        <!--
          LOWER LINK (connecting rod): passive hinge at crank tip.
          Origin at (0,0,-0.25) in upper_link frame.
          At init: world pos = (0, 0, 0.45).
          Rod tip site at (0,0,-0.45) in lower_link frame = (0,0,0) world at init.
          Equality constraint below pins rod_tip to foot_anchor.
        -->
        <body name="lower_link" pos="0 0 -0.20">
          <joint name="connect_hinge" type="hinge"
                 axis="0 1 0" limited="false"
                 damping="0.3" stiffness="0.0"/>

          <geom name="conn_sphere" type="sphere" size="0.022"
                material="joint_mat" contype="0" conaffinity="0"/>
          <geom name="lower_link_geom" type="cylinder"
                size="0.016 0.100" pos="0 0 -0.100"
                material="lower_mat" contype="0" conaffinity="0"/>

          <!-- Rod tip: touches ground at init, pinned there by equality -->
          <site name="rod_tip" pos="0 0 -0.20" size="0.014"/>
        </body>
      </body>
    </body>

  </worldbody>

  <!--
    CRANK-SLIDER CONSTRAINT (inverted)
    Pins the rod tip (lower_link end) to the foot_anchor on the ground.
    This closes the kinematic loop: crank rotation → pelvis slides in Z.

    anchor = rod tip in lower_link frame = (0,0,-0.45)
    At init: world pos of anchor = (0,0,0) = foot_anchor origin ✓

    MuJoCo derives the foot_anchor offset automatically from the
    initial world position of the anchor point.
  -->
  <equality>
    <connect body1="lower_link" body2="foot_anchor"
             anchor="0 0 -0.20"
             solimp="0.999 0.9999 0.001 0.5 2"
             solref="0.005 1"/>
  </equality>

  <!--
    SINGLE ACTUATOR — hip motor drives the crank.
    ctrl[0] in [-1, 1], gear=60 → max torque ±60 Nm.
  -->
  <actuator>
    <motor name="hip_motor" joint="hip" gear="60"
           ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>

  <!--
    SENSORS
    Index layout:
      [0:3]  imu_accel      (ax, ay, az)
      [3]    hip_pos        hip angle (rad)
      [4]    conn_pos       connecting-rod hinge angle (rad)
      [5]    slide_z_pos    pelvis vertical offset from rest (m)
      [6]    hip_vel        hip angular velocity
      [7]    conn_vel       connecting-rod angular velocity
      [8]    slide_z_vel    pelvis vertical velocity
      [9:12] rod_tip_pos    world position of rod tip (should stay near 0,0,0)
      [12:15]pelvis_pos     world position of pelvis
  -->
  <sensor>
    <accelerometer name="imu_accel"    site="pelvis_site"/>
    <jointpos       name="hip_pos"     joint="hip"/>
    <jointpos       name="conn_pos"    joint="connect_hinge"/>
    <jointpos       name="slide_z_pos" joint="slide_z"/>
    <jointvel       name="hip_vel"     joint="hip"/>
    <jointvel       name="conn_vel"    joint="connect_hinge"/>
    <jointvel       name="slide_z_vel" joint="slide_z"/>
    <framepos       name="rod_tip_pos" objtype="site" objname="rod_tip"/>
    <framepos       name="pelvis_pos"  objtype="site" objname="pelvis_site"/>
  </sensor>

</mujoco>
